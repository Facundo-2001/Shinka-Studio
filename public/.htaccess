# Apache / LiteSpeed (Hostinger).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) www -> sin www, con 301 permanente.
  #    Sin esto el sitio responde en las dos versiones y Google las ve como
  #    dos sitios distintos con el mismo contenido.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2) Sirve /servicios desde /servicios/index.html y devuelve un 404 real
  #    en las URLs que no existen.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

ErrorDocument 404 /404.html
